# Copier ce fichier en .env puis remplacer chaque valeur « a-changer ».
# Le fichier .env n'est jamais versionné.

APP_ENV=development
APP_TIMEZONE=Europe/Paris

# Clé de signature des sessions (au moins 32 caractères).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=a-changer-par-une-cle-aleatoire-de-48-caracteres-minimum
SESSION_DURATION_MINUTES=600
# true derrière HTTPS (profil docker « https » ou production)
COOKIE_SECURE=false

# PostgreSQL
POSTGRES_USER=garage
POSTGRES_PASSWORD=a-changer
POSTGRES_DB=garage
# Port exposé sur la machine hôte (5433 pour ne pas gêner un Postgres local)
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://garage:a-changer@db:5432/garage
# Base dédiée aux tests (service db-test)
TEST_DATABASE_URL=postgresql+psycopg://garage:a-changer@db-test:5432/garage_test

# Mots de passe des comptes de démonstration créés par « python -m app.cli seed »
DEMO_PASSWORD_GERANT=a-changer
DEMO_PASSWORD_MECANICIEN=a-changer

# Mentions légales du garage (fictives en démonstration)
GARAGE_RAISON_SOCIALE=Garage Établi SARL
GARAGE_ADRESSE=12 rue des Ateliers, 69007 Lyon
GARAGE_SIRET=000 000 000 00000
GARAGE_TVA_INTRA=FR00000000000
GARAGE_CAPITAL=10 000 €
GARAGE_RCS=RCS Lyon 000 000 000
GARAGE_TELEPHONE=04 00 00 00 00
GARAGE_EMAIL=contact@garage-etabli.test
# Délai de paiement des factures, en jours (60 au plus)
GARAGE_DELAI_PAIEMENT_JOURS=30
